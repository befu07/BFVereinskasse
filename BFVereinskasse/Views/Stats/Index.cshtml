@model StatsIndexVM


<div class="row">
    <div class="col-3 align-self-center">
        <h1>
            Statistiken
        </h1>
    </div>
    @*     <div class="col-3 align-self-center">
    <a href="/Payment/CreatePayment" class="btn btn-sm btn-outline-success ">+ Neue Zahlung</a>
    </div> *@
    <div class="col-3 align-self-center">
        <span class="text-success">@TempData["SuccessMessage"]</span>
        <span class="text-danger">@TempData["ErrorMessage"]</span>
    </div>
</div>

<div class="row">
    <div class="col-3 align-self-center">
        <h2>
            Übersicht
        </h2>
    </div>
</div>
<table class="table">
    <thead>
    <th>
        Summe Ein
    </th>
    <th>
        Summe Aus
    </th>
    <th>
        Kontostand
    </th>
    </thead>
    <tr>
        <td>
            @Model.SumIn
        </td>
        <td>
            @Model.SumOut
        </td>
        <td>
            @Model.SumTotal
        </td>
    </tr>
</table>



<div class="row">
    <div class="col-3 align-self-center">
        <h2>
            Gefiltert
        </h2>
    </div>
</div>

<table class="table">
    <thead>
    <th>
        Summe Ein
    </th>
    <th>
        Summe Aus
    </th>
    <th>
        Kontostand
    </th>
    </thead>
    <tr>
        <td id="filteredSumDeposits"></td>
        <td id="filteredSumWithdrawals"></td>
        <td id="filteredBalance"></td>
    </tr>
</table>


<div class="">
    <div class="row">
        <div class="col-1">
            Mitglied:
        </div>
        <div class="col-3">
            <select id="memberId" name="MemberId">
                <option value=""> ...</option>
                @foreach (var member in Model.Members)
                {
                    if (member.Id == Model.MemberId)
                    {
                        <option selected value="@member.Id"> @member.Vorname @member.Nachname </option>
                    }
                    else
                    {
                        <option value="@member.Id"> @member.Vorname @member.Nachname </option>
                    }
                }
            </select>
        </div>
@*         <div class="col-2">
            ZeitRaum
        </div> *@
        <div class="col-1">
            Von:
            <br />
            Bis:
        </div>
        <div class="col-2">
            <input type="date" id="startDate" name="StartDate" />
            <br />
            <input type="date" id="endDate" name="EndDate" />
        </div>
    </div>
    <div class="row">
        <div class="col-2">
            <input type="submit" value="Filter anwenden" onclick="fetchApi(memberId, startDate.value, endDate)" />
        </div>
    </div>
</div>


<canvas id="myChart" style="width:100%;max-width:700px;max-height:300px;"></canvas>

<canvas id="Highest5" style="width:100%;max-width:700px"></canvas>

@* <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.3/Chart.js"></script> *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@section Scripts {
    <script>
        console.log('Chart.js version:', Chart.version);

        // Function to fetch JSON data from the specified URL
        async function fetchHighestStats(url) {
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error('Network response was not ok ' + response.statusText);
                }
                const data = await response.json();
                console.log("");
                return data;
            } catch (error) {
                console.error('There has been a problem with your fetch operation:', error);
            }
        }

        function fetchApi() {
            let memberIdValue = document.getElementById('memberId').value;
            let startdateValue = document.getElementById('startDate').value;
            let enddateValue = document.getElementById('endDate').value;

            const basePath = '/Stats/Highest';
            const params = new URLSearchParams({
                memberId: memberIdValue,
                startdate: startdateValue,
                enddate: enddateValue
            });
            const relativeUrl = `${basePath}?${params.toString()}`;

            // const url = new URL('/Stats/Highest');
            // Object.keys(paramobject).forEach(key => url.searchParams.append(key, params[key]));

            console.log(relativeUrl);

            // Call the function to fetch the data
            fetchHighestStats(relativeUrl).then(data => {
                if (window.myBar !== undefined)
                    window.myBar.destroy();
                console.log(data); // Use the fetched data here
                const ctx = document.getElementById('myChart');
                window.myBar = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.objekte.map(foo => foo.name),
                        datasets:
                            [{
                                label: 'Zahlung',
                                data: data.objekte.map(foo => foo.amount),
                                borderWidth: 3,
                                borderColor: 'green',
                                backgroundColor: data.objekte.map(foo => foo.color),
                            }]
                    },
                    options: {
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        const index = context.dataIndex;
                                        const zahlung = data.objekte[index];
                                        let tooltiptext = [zahlung.amount.toLocaleString('de-DE', {
                                            style: 'currency',
                                            currency: 'EUR',
                                            minimumFractionDigits: 2
                                        }), zahlung.date, zahlung.description];

                                        return tooltiptext;
                                        // return data.objekte[index].description;
                                    }
                                }
                            }
                        }
                    }
                });

                document.getElementById('filteredSumDeposits').innerHTML = data.sumDeposits;
                document.getElementById('filteredSumWithdrawals').innerHTML = data.sumWithdrawals;
                document.getElementById('filteredBalance').innerHTML = data.balance;

            }).catch(error => {
                console.error('Error fetching data:', error);
            });
        }

        fetchApi();

    </script>
}

